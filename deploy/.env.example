# Copy to `.env` beside this file and fill in. `.env` is git-ignored.
#
# Every value without a default is required: the stack refuses to start rather
# than coming up on something guessable. That is deliberate — the first version
# of the development compose shipped working defaults, and a working default is
# a default that reaches production.

# --- the name people type ---------------------------------------------------
# Must already resolve to this host before the first start: Caddy proves
# control of it to Let's Encrypt over port 80, and a name that does not yet
# point here fails that check and counts against the issuance rate limit.
DOMAIN=organizer.example.com

# Where Let's Encrypt writes if a renewal fails. Not marketing mail — this is
# the address that finds out before a certificate expires.
TLS_EMAIL=it@example.com

# The ports the stack takes on the host, and the address people actually type.
#
# Leave these alone on a dedicated host. Change them when something else
# already owns 80 and 443 — and if you do, PUBLIC_ORIGIN has to carry the port,
# because it is handed to the browser and a browser cannot guess one. Getting
# it wrong means a panel that loads and cannot reach its API.
HTTP_PORT=80
HTTPS_PORT=443
PUBLIC_ORIGIN=https://organizer.example.com

# --- secrets ----------------------------------------------------------------
# Generate, do not invent:
#   POSTGRES_PASSWORD:  openssl rand -base64 32
#   JWT_SECRET_KEY:     openssl rand -base64 48
#
# Rotating JWT_SECRET_KEY signs everybody out at once; that is the intended
# behaviour after a suspected leak, and worth knowing before doing it casually.
POSTGRES_PASSWORD=
JWT_SECRET_KEY=

# The first account. Change the password at first sign-in; it exists to let
# somebody in, not to be kept.
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=

# --- images -----------------------------------------------------------------
# Pin to a tag rather than `latest` for a deployment you intend to reproduce.
# `latest` is what a demo runs; a site runs a version somebody can name.
API_IMAGE=ghcr.io/sickmajkan-design/planconcept-stas-organizer/api:latest
ADMIN_IMAGE=ghcr.io/sickmajkan-design/planconcept-stas-organizer/admin:latest

# --- email ------------------------------------------------------------------
# Without SMTP nobody can reset a password. Leave these empty only together
# with SMTP_ALLOW_UNCONFIGURED=true, which makes it a decision rather than an
# oversight — the API refuses to start in Production otherwise.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=organizer@example.com
SMTP_ALLOW_UNCONFIGURED=false

# --- optional ---------------------------------------------------------------
# Browser key for the live map. Without it the map page explains what is
# missing and still lists the positions.
GOOGLE_MAPS_API_KEY=

# Push notifications. Empty means push is logged instead of sent.
FIREBASE_CREDENTIALS_JSON=

# Object storage for attachments. Empty means the container's own disk, kept on
# a volume — fine for one host, not for two.
FILE_STORAGE_BUCKET=
FILE_STORAGE_SERVICE_URL=
FILE_STORAGE_REGION=
FILE_STORAGE_ACCESS_KEY=
FILE_STORAGE_SECRET_KEY=

# Where metrics and traces go. Empty means they are collected in-process and
# never leave, which is the state H3 is about.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- backups ----------------------------------------------------------------
# Without OFFSITE_*, backups land on a volume on this host: they survive a
# dropped table and do not survive the host. The backup says so on every run.
BACKUP_RETENTION_DAYS=14
OFFSITE_ENDPOINT=
OFFSITE_BUCKET=
OFFSITE_PREFIX=construction/
OFFSITE_REGION=us-east-1
OFFSITE_PATH_STYLE=0
OFFSITE_ACCESS_KEY_ID=
OFFSITE_SECRET_ACCESS_KEY=
# Public age recipient, if the copies should be encrypted before they leave.
OFFSITE_AGE_RECIPIENT=
