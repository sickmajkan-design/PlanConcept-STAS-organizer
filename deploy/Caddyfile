# The edge. One name, two upstreams, TLS that renews itself.
#
# Caddy obtains a certificate from Let's Encrypt on first start and renews it
# without being asked, which is the whole reason it is here rather than nginx:
# a certificate nobody has to remember to renew is a certificate that does not
# expire on a Sunday.
#
# For a host without a public name — a staging box on a private network, or a
# smoke test — set `DOMAIN` to something like `localhost` and Caddy issues its
# own internally-trusted certificate instead of asking Let's Encrypt. That is
# what the compose smoke test in docs/PROVISIONING.md §6.5 does.

{
	email {$TLS_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# The API and the panel share an origin on purpose. The refresh token is a
	# `SameSite=Strict` cookie: served from a different origin than the one the
	# browser is on, it would not be sent at all, and the panel would sign the
	# operator out on every reload. Same origin also means no CORS to
	# misconfigure.
	handle /api/* {
		reverse_proxy api:8080
	}

	# The probes, reachable for an uptime check without exposing the whole API
	# on another port. /health/live says the process is up; /health/ready says
	# it can reach the database.
	handle /health/* {
		reverse_proxy api:8080
	}

	# Swagger is served only outside Production by the API itself, so this
	# route exists for staging and answers 404 in production. Routing it here
	# rather than leaving it unrouted means the answer comes from the API,
	# which is the thing that knows.
	handle /swagger/* {
		reverse_proxy api:8080
	}

	# A plain download link for the Android APK during test rollout, before
	# there is a Play Store listing to point people at instead. Whatever is
	# dropped into the `downloads/` directory beside this file is served
	# as-is — nothing here knows or cares that it is currently one APK.
	handle_path /downloads/* {
		root * /srv/downloads
		file_server
	}

	# The panel is the one page here where injected script matters: it is where
	# the access token lives. Set on this route only, because a plain `header`
	# would replace the API's own `default-src 'none'` on /api/* with this
	# looser policy.
	#
	# What each allowance is for:
	#   * 'unsafe-inline' styles: MUI/emotion inject <style> tags at runtime.
	#   * maps.googleapis.com / gstatic / ggpht: the live map. Drop these if the
	#     installation has no GOOGLE_MAPS_API_KEY.
	#   * blob: workers/images: the map's tile workers.
	# Scripts stay 'self' plus Google Maps: no inline script, no eval.
	handle {
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self' https://maps.googleapis.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://maps.googleapis.com https://maps.gstatic.com https://*.ggpht.com https://*.googleapis.com; font-src 'self' data:; connect-src 'self' https://maps.googleapis.com https://*.googleapis.com; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
		}
		reverse_proxy admin:8080
	}

	header {
		# HSTS. Not set by the API, because the API does not know whether it is
		# behind TLS — the proxy does, and this is the only place that can say
		# it truthfully.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# Removed rather than set: the upstreams' own names are not the
		# client's business.
		-Server
		-X-Powered-By
	}

	log {
		output stdout
		format json
	}
}
