<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Construction.UnitTests</RootNamespace>
    <AssemblyName>Construction.UnitTests</AssemblyName>
    <IsPackable>false</IsPackable>
    <!--
      The projects target net9.0, but a machine may only have a newer runtime
      installed. Rolling forward keeps the tests runnable there without
      pinning the whole solution to a different framework.
    -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Construction.Application\Construction.Application.csproj" />
    <ProjectReference Include="..\..\src\Construction.Infrastructure\Construction.Infrastructure.csproj" />
    <!-- For the API-layer security configuration: trusted proxies decide the
         client address the rate limiter partitions on. -->
    <ProjectReference Include="..\..\src\Construction.API\Construction.API.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
