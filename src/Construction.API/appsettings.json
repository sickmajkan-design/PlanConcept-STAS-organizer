{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "//": "Off by default: with more than one replica, concurrent instances would race to migrate. Enable per environment, or run migrations as a separate deploy step.",
    "ApplyMigrationsOnStartup": false
  },
  "JwtSettings": {
    "Issuer": "construction-api",
    "Audience": "construction-clients",
    "SecretKey": "",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7
  },
  "ClientApp": {
    "PasswordResetUrl": "https://localhost:5173/reset-password"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Network": {
    "//": "Addresses of reverse proxies whose X-Forwarded-For may be believed. Empty means the client address comes from the connection. Anything listed here can choose the address used for rate-limiting and audit, so list only proxies you operate.",
    "TrustedProxies": ""
  },
  "Firebase": {
    "CredentialsPath": "",
    "CredentialsJson": ""
  },
  "EmailSettings": {
    "Host": "",
    "Port": 587,
    "UseStartTls": true,
    "Username": "",
    "Password": "",
    "FromAddress": "no-reply@construction.local",
    "FromName": "Construction Workforce"
  },
  "Seed": {
    "SuperAdmin": {
      "Email": "",
      "Password": ""
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/construction-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
