# Database dumps. BACKUP_DIR defaults to ./backups, so without this the first
# run of scripts/backup.sh puts every employee record, GPS track and audit
# entry into the repository — and a dump is not something a .gitignore added
# later can take back out of the history.
/backups/
*.dump
*.dump.sha256

# Deployment environment, filled in per host. Never committed.
deploy/.env

# Local attachment storage (FileSystemFileStorage's default root). Every
# attachment row in the database points at a file here by StorageKey; a
# `git clean` on an untracked directory like this one deletes the bytes while
# the database rows survive, leaving attachments that 404 forever. Ignoring
# it does not make it durable — only S3-backed storage (configure
# FileStorage:Bucket) is — but it stops git from being the thing that wipes it.
/src/Construction.API/storage/

# Whatever a host drops in deploy/downloads/ for the Caddyfile's /downloads/*
# route (an APK during test rollout, say) — a build artifact, not source.
/deploy/downloads/*
!/deploy/downloads/.gitkeep
