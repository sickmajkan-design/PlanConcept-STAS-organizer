# Copy to .env before running `docker compose up`.
#
#   cp .env.example .env
#
# The values below are fine for local development and must not be reused
# anywhere else. `.env` is git-ignored; `.env.example` is not, so never put a
# real secret in this file.

# --- Database ---------------------------------------------------------------
POSTGRES_PASSWORD=postgres

# --- Authentication ---------------------------------------------------------
# Signing key for access tokens. Minimum 32 characters; the API refuses to
# start below that. Anyone holding this key can mint a token for any role, so
# generate a fresh one per environment and never commit it:
#
#   openssl rand -base64 48
#
JWT_SECRET_KEY=local-development-only-key-not-for-any-real-deployment

# --- Initial account --------------------------------------------------------
# Seeded only when no Super Admin exists yet. Change the password immediately
# after the first sign-in on any shared environment.
SUPERADMIN_EMAIL=admin@construction.local
SUPERADMIN_PASSWORD=Admin123!

# --- Runtime ----------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development

# Convenient for a single local container. Keep it false anywhere that runs
# more than one replica: they would race to apply migrations.
APPLY_MIGRATIONS_ON_STARTUP=true

# Comma-separated addresses of reverse proxies whose X-Forwarded-For header
# may be believed. Leave empty when nothing sits in front of the API — an
# unset value means the client address is taken from the connection, which is
# what the login rate limiter partitions on.
TRUSTED_PROXIES=
