# Copy to .env before running `docker compose up`.
#
#   cp .env.example .env
#
# The values below are fine for local development and must not be reused
# anywhere else. `.env` is git-ignored; `.env.example` is not, so never put a
# real secret in this file.

# --- Database ---------------------------------------------------------------
POSTGRES_PASSWORD=postgres

# --- Authentication ---------------------------------------------------------
# Signing key for access tokens. Minimum 32 characters; the API refuses to
# start below that. Anyone holding this key can mint a token for any role, so
# generate a fresh one per environment and never commit it:
#
#   openssl rand -base64 48
#
JWT_SECRET_KEY=local-development-only-key-not-for-any-real-deployment

# --- Initial account --------------------------------------------------------
# Seeded only when no Super Admin exists yet. Change the password immediately
# after the first sign-in on any shared environment.
SUPERADMIN_EMAIL=admin@construction.local
SUPERADMIN_PASSWORD=Admin123!

# --- Runtime ----------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development

# Convenient for a single local container. Keep it false anywhere that runs
# more than one replica: they would race to apply migrations.
APPLY_MIGRATIONS_ON_STARTUP=true

# --- Backups ------------------------------------------------------------------
# Days a dump is kept before the nightly sweep removes it. The backup service
# is opt-in — `docker compose --profile backup up` — because a development
# stack does not need it and a deployment should not rely on the default.
#
# A dump on a volume beside the database survives a dropped table and a bad
# migration; it does not survive the host. Copy them off the machine and test a
# restore on a schedule: see docs/PROVISIONING.md.
BACKUP_RETENTION_DAYS=14

# --- Retention / privacy ------------------------------------------------------
# Days of GPS history kept. 0 keeps everything and logs a warning at startup.
# A minute-by-minute record of where an employee was is personal data; see
# docs/PRIVACY.md before raising this.
# RETENTION_LOCATION_RECORD_DAYS=180
#
# A shift's clock-in and clock-out coordinates outlive the GPS window on
# purpose — an approved timesheet is payroll evidence. Set a number to bound
# them; the hours are kept either way.
# RETENTION_TIME_ENTRY_COORDINATE_DAYS=0

# --- Push notifications -----------------------------------------------------
# The Firebase service-account JSON, on one line. Leave empty and the API logs
# pushes instead of sending them, which is what you want locally and in CI.
#
# Generate it in the Firebase console under
# Project settings → Service accounts → Generate new private key, then flatten:
#
#   jq -c . service-account.json
#
# This is a credential that can send push to every installed device, so it
# belongs in a secret manager in production — never in a committed file.
FIREBASE_CREDENTIALS_JSON=

# --- File storage ------------------------------------------------------------
# Leave the bucket empty and uploads go to a directory on the API container's
# disk, which is fine for a single instance and for local work. Anything
# running more than one replica must set a bucket: two instances on local disk
# each hold half the files, and a restart of an ephemeral container loses them.
#
# Any S3-compatible service works — MinIO, Backblaze B2, a European provider —
# not only AWS.
FILE_STORAGE_BUCKET=
FILE_STORAGE_SERVICE_URL=
FILE_STORAGE_REGION=
FILE_STORAGE_ACCESS_KEY=
FILE_STORAGE_SECRET_KEY=

# Comma-separated addresses of reverse proxies whose X-Forwarded-For header
# may be believed. Leave empty when nothing sits in front of the API — an
# unset value means the client address is taken from the connection, which is
# what the login rate limiter partitions on.
TRUSTED_PROXIES=
